# SocialPulse AI — Production Environment Variables

# App URL / OAuth Redirect Callback URI
VITE_OAUTH_REDIRECT_URI=https://socialpulse.yourdomain.com/oauth/callback

# Meta (Facebook & Instagram) Developer App Credentials
# Create App at: https://developers.facebook.com/
VITE_META_APP_ID=your_meta_app_id_here
VITE_META_APP_SECRET=your_meta_app_secret_here

# LinkedIn Developer App Credentials
# Create App at: https://www.linkedin.com/developers/
VITE_LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
VITE_LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here

# Twitter / X Developer API v2 Credentials
# Create App at: https://developer.twitter.com/
VITE_TWITTER_CLIENT_ID=your_twitter_client_id_here

# TikTok for Business App Credentials
# Create App at: https://developers.tiktok.com/
VITE_TIKTOK_CLIENT_KEY=your_tiktok_client_key_here

# Pinterest Business App Credentials
# Create App at: https://developers.pinterest.com/
VITE_PINTEREST_APP_ID=your_pinterest_app_id_here
